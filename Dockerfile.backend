FROM node:22-bookworm-slim AS builder

WORKDIR /app
COPY . .
RUN npm ci
RUN npm run generate:db
RUN npm run build --workspace backend

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080
# Seedream returns large edited images; allow Node to use the VPS memory
# instead of stopping at its default V8 heap limit during image processing.
ENV NODE_OPTIONS=--max-old-space-size=4096

# PDFKit needs a font with Arabic glyphs for the final-cover copy.
RUN apt-get update \
  && apt-get install -y --no-install-recommends fonts-dejavu-core \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder /app/apps/backend/package.json ./apps/backend/package.json
COPY --from=builder /app/packages/db ./packages/db
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/apps/backend/src/covers ./apps/backend/src/covers
# Keep repository-managed catalogue covers available even when the runtime
# assets volume is mounted over /app/apps/backend/assets.
COPY --from=builder /app/apps/backend/assets/covers ./apps/backend/src/covers
COPY --from=builder /app/apps/backend/src/fonts ./apps/backend/src/fonts

RUN mkdir -p /app/assets/pdfs /app/assets/previews /app/assets/covers
EXPOSE 8080
CMD ["node", "apps/backend/dist/index.js"]
