
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  clerkId           String   @unique
  email             String   @unique
  name              String?
  profilePicture    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Free story generations. Every account starts with 3 and each printed
  // book order grants 1 more. Set to 0 when no generations are left.
  trialGenerations  Int      @default(3)
  
  // Existing relations...
  models            Model[]
  outputImages      OutputImages[]
  stories           Story[]
  orders            Order[]
  
  @@index([clerkId])
  @@index([email])
}

enum ModelTrainingStatusEnum {
  Pending
  Generated
  Failed
}

model Model {
  id              String      @id @default(uuid())
  name            String
  type            ModelTypeEnum
  age             Int
  ethinicity      EthenecityEnum  
  eyeColor        EyeColorEnum
  bald            Boolean
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  triggerWord     String?
  tensorPath      String?
  thumbnail       String?
  trainingStatus  ModelTrainingStatusEnum @default(Pending)
  outputImages    OutputImages[]
  stories         Story[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  falAiRequestId  String?
  zipUrl          String
  open            Boolean    @default(false)
  
  @@index([falAiRequestId])
  @@index([userId, trainingStatus])
  @@index([open, trainingStatus])
}

enum OutputImageStatusEnum {
  Pending
  Generated
  Failed
}

model OutputImages {
  id        String  @id @default(uuid())
  imageUrl  String  @default("")
  modelId   String
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  prompt    String
  falAiRequestId    String?
  status    OutputImageStatusEnum   @default(Pending)
  model     Model   @relation(fields: [modelId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([falAiRequestId])
  @@index([userId, status])
  @@index([modelId, status])
}

model Packs {
  id        String   @id @default(uuid())
  name      String
  description String @default("")
  imageUrl1    String @default("")
  imageUrl2    String @default("")
  prompts   PackPrompts[]
}

model PackPrompts {
  id        String    @id @default(uuid())
  prompt    String
  packId    String
  pack      Packs    @relation(fields: [packId], references: [id])
}

enum ModelTypeEnum {
  Man
  Woman
  Others
}

enum EthenecityEnum {
  White
  Black
  Asian_American    @map("Asian American")
  East_Asian        @map("East Asian")
  South_East_Asian  @map("South East Asian")
  South_Asian       @map("South Asian")
  Middle_Eastern    @map("Middle Eastern")
  Pacific
  Hispanic
}

enum EyeColorEnum {
  Brown
  Blue
  Hazel
  Gray
}

// Enhanced Story Features
model Story {
  id          String   @id @default(uuid())
  title       String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  modelId     String
  model       Model    @relation(fields: [modelId], references: [id])
  status      StoryStatusEnum @default(Pending)
  pages       StoryPage[]
  analytics   StoryAnalytics?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Enhanced personalization fields
  childName   String?
  childAge    Int?
  storyLength StoryLengthEnum @default(medium)
  category    String @default("adventure")
  dedication  String?
  templateId  String?
  template    StoryTemplate? @relation(fields: [templateId], references: [id])
  
  // Audio narration settings
  includeAudio Boolean @default(false)
  voiceId      String? // ElevenLabs voice ID
  
  // Sharing & visibility
  isPublic    Boolean @default(false)
  shareToken  String? @unique
  readCount   Int @default(0)
  
  // Metadata
  tags        String[]
  language    String @default("en")
  readingTime Int? // in minutes
  
  // Completion tracking
  completedAt DateTime?
  pdfUrl      String?
  
  orders      Order[]
  
  @@index([userId, status])
  @@index([createdAt])
  @@index([isPublic, status])
  @@index([shareToken])
}

model StoryTemplate {
  id          String   @id @default(uuid())
  name        String
  description String
  ageRange    String
  category    String @default("adventure")
  prompts     Json
  sampleImage String?
  coverImage  String?
  isActive    Boolean @default(true)
  difficulty  Int @default(1)
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  stories     Story[]
  
  @@index([category, ageRange])
  @@index([isActive])
  @@index([difficulty])
}

model UserPreferences {
  id                String   @id @default(uuid())
  userId            String   @unique
  defaultAge        Int @default(5)
  autoDedication    Boolean @default(true)
  preferredLength   StoryLengthEnum @default(medium)
  preferredCategory String @default("adventure")
  language          String @default("en")
  emailNotifications Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([userId])
}

model StoryAnalytics {
  id          String   @id @default(uuid())
  storyId     String   @unique
  story       Story    @relation(fields: [storyId], references: [id])
  views       Int @default(0)
  shares      Int @default(0)
  downloads   Int @default(0)
  avgReadTime Int? // in seconds
  lastReadAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([storyId])
  @@index([lastReadAt])
}

// Enhanced enums
enum StoryStatusEnum {
  Pending
  Generating
  Completed
  Failed
  Processing
}

enum StoryLengthEnum {
  short    // 5 pages
  medium   // 8 pages  
  long     // 12 pages
  extended // 16 pages
}

enum StoryCategoryEnum {
  bedtime
  adventure
  friendship
  learning
  animals
  fantasy
  moral
  seasonal
  science
  history
  emotions
  family
}

model StoryPage {
  id             String   @id @default(uuid())
  storyId        String
  story          Story    @relation(fields: [storyId], references: [id])
  pageNumber     Int
  content        String   @db.Text
  imageUrl       String?
  audioUrl       String?
  imagePrompt    String
  falAiRequestId String?
  status         OutputImageStatusEnum @default(Pending)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([falAiRequestId])
  @@index([storyId, pageNumber])
  @@index([storyId, status])
}

// Physical book orders (Cash on Delivery)
enum OrderStatusEnum {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethodEnum {
  CASH_ON_DELIVERY
}

enum PaymentStatusEnum {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id            String             @id @default(uuid())
  orderNumber   String             @unique
  userId        String
  user          User               @relation(fields: [userId], references: [id])
  storyId       String
  story         Story              @relation(fields: [storyId], references: [id])

  // Customer delivery details
  customerName  String
  phone         String
  address       String             @db.Text
  city          String
  postalCode    String?

  // Price
  totalAmount   Decimal            @db.Decimal(10, 2)
  currency      String             @default("USD")

  // Payment
  paymentMethod PaymentMethodEnum  @default(CASH_ON_DELIVERY)
  paymentStatus PaymentStatusEnum  @default(PENDING)

  // Fulfillment
  status        OrderStatusEnum    @default(PENDING)

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId])
  @@index([storyId])
  @@index([status])
  @@index([orderNumber])
}

// Page visit & click tracking. Used for the admin analytics dashboard and
// the public site statistics page. `sessionId` is a per-browser random id
// (localStorage) used to approximate unique visitors without cookies/PII.
model PageEvent {
  id        String         @id @default(uuid())
  eventType PageEventType
  path      String
  label     String? // click label, e.g. "Try for free" or a data-track key
  referrer  String? // for clicks: target href; for visits: HTTP referrer
  sessionId String?
  userId    String?
  createdAt DateTime       @default(now())

  @@index([eventType, createdAt])
  @@index([path, createdAt])
  @@index([sessionId])
  @@index([createdAt])
}

enum PageEventType {
  visit
  click
}
