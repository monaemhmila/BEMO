{
  "name": "@portrait-ai/db",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22.11.0"
  },
  "exports": {
    ".": "./index.ts"
  },
  "prisma": {
    "seed": "npx ts-node prisma/seed.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "npx ts-node prisma/seed.ts",
    "db:seed:templates": "npx ts-node prisma/seed-templates.ts",
    "db:backfill-localized-copy": "npx ts-node prisma/backfill-localized-copy.ts",
    "migrate:stories": "npx ts-node prisma/migrate-story-templates.ts",
    "migrate:generated-stories": "npx ts-node prisma/migrate-stories.ts",
    "build": "tsc && prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0"
  },
  "devDependencies": {
    "prisma": "^7.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
