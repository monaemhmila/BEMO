NODE_ENV=production
PORT=8080

POSTGRES_DB=mon_petit_hero
POSTGRES_USER=mon_petit_hero
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://mon_petit_hero:replace-with-a-long-random-password@db:5432/mon_petit_hero?schema=public

# Public URLs
NEXT_PUBLIC_BACKEND_URL=https://api.example.com
FRONTEND_URL=https://example.com
CORS_ORIGINS=https://example.com,https://www.example.com
WEBHOOK_BASE_URL=https://api.example.com

# Required application credentials
CLERK_JWT_PUBLIC_KEY=replace-with-production-clerk-jwt-public-key
FAL_KEY=replace-with-production-fal-key
OPENAI_API_KEY=replace-with-openai-key

# Optional object storage for durable generated assets
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
BUCKET_NAME=
S3_ENDPOINT=
STORAGE_PUBLIC_URL=

LOG_LEVEL=info
SENTRY_DSN=
