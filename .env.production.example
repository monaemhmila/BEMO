NODE_ENV=production
PORT=8080

POSTGRES_DB=mon_petit_hero
POSTGRES_USER=mon_petit_hero
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://mon_petit_hero:replace-with-a-long-random-password@db:5432/mon_petit_hero?schema=public

# Public URLs
NEXT_PUBLIC_BACKEND_URL=https://api.monpetithero.shop
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-production-clerk-publishable-key
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=replace-with-production-clerk-jwt-template
NEXT_PUBLIC_SITE_URL=https://monpetithero.shop
FRONTEND_URL=https://monpetithero.shop
CORS_ORIGINS=https://monpetithero.shop,https://www.monpetithero.shop
WEBHOOK_BASE_URL=https://api.monpetithero.shop
PUBLIC_ASSET_BASE_URL=https://api.monpetithero.shop
REDIS_URL=redis://redis:6379

# Required application credentials
CLERK_JWT_PUBLIC_KEY=replace-with-production-clerk-jwt-public-key
FAL_KEY=replace-with-production-fal-key
OPENAI_API_KEY=replace-with-openai-key
ADMIN_EMAIL=replace-with-your-admin-email
SIGNING_SECRET=replace-with-clerk-webhook-signing-secret

# Cash-on-delivery book pricing
BOOK_PRICE_TND=70
BOOK_CURRENCY=TND

# Optional object storage for durable generated assets
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
BUCKET_NAME=
S3_ENDPOINT=
STORAGE_PUBLIC_URL=

LOG_LEVEL=info
SENTRY_DSN=
