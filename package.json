{
  "name": "portrait-ai",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "start:web": "cd ./apps/web && npm run start",
    "start:backend": "cd ./apps/backend && npm run start",
    "generate:db": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "seed": "cd ./packages/db && npm run db:seed",
    "seed:templates": "cd ./packages/db && npm run db:seed:templates",
    "db:push": "prisma db push --schema=packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
    "db:status": "prisma migrate status --schema=packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=packages/db/prisma/schema.prisma"
  },
  "devDependencies": {
    "@types/node": "^24.0.4",
    "prettier": "^3.5.0",
    "ts-node": "^10.9.2",
    "turbo": "^2.4.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.5"
  }
}
